# Copy to /etc/rdm/rdm.env and adjust. systemd reads this file directly.
RDM_DATA_DIR=/var/lib/rdm
# Default loopback (nginx on this host). If nginx runs elsewhere, bind 0.0.0.0
# or the private IP, set RDM_PUBLIC_BASE_URL below, and restrict the port with
# a firewall/security group to the proxy only.
RDM_HOST=127.0.0.1
RDM_PORT=8765
# Public origin users and MCP clients reach (through nginx). Must be HTTPS
# unless it is loopback. OAuth metadata, web_url and attachment links use it.
RDM_PUBLIC_BASE_URL=https://rdm.example.com

# Optional PostgreSQL + ParadeDB backend (needs the `postgres` extra).
# RDM_DATABASE_URL=postgresql://rdm:change-me@127.0.0.1:5432/rdm
