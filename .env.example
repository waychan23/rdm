# rdm server settings. The application does NOT load .env automatically:
# export these in your shell, or point systemd/Docker at this file.
RDM_DATA_DIR=$HOME/rdm-data
# Default loopback. For LAN/container deployments use 0.0.0.0 (or a private IP)
# together with an HTTPS RDM_PUBLIC_BASE_URL; /api/v1/local/* stays local-only.
RDM_HOST=127.0.0.1
RDM_PORT=8765
# Public origin used by browsers and MCP clients (HTTPS unless loopback).
RDM_PUBLIC_BASE_URL=http://127.0.0.1:8765

# Optional PostgreSQL + ParadeDB backend (requires the `postgres` extra).
# RDM_DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/rdm

# Optional tuning
# RDM_ATTACHMENT_MAX_BYTES=20971520
# RDM_EXTRA_REDIRECT_URIS=
# RDM_WEBHOOK_POLL_SECONDS=2.0
# RDM_WEBHOOK_TIMEOUT_SECONDS=5.0
# RDM_WEBHOOK_BACKOFF=60,300,900

# CLI client settings (used by `rdm` commands that talk to a server)
# RDM_SERVER_URL=http://127.0.0.1:8765
# RDM_TOKEN=
# RDM_PROJECT=
