          },
        ],
        CLOSED_REJECTED: [
          {
            key: "REOPEN",
            name: "重新打开",
            name_en: "Reopen",
            to: "REOPEN",
          },
        ],
        CANCELLED: [],
      },
      gates: {
        CLOSED_DONE: {
          children_all_terminal: true,
          min_children: 1,
        },
      },
    },
    // 普通任务：引用标准任务流程；任务类型可通过 subtypes 覆盖。
    task: {
      label: "任务",
      label_en: "Task",
      // states/initial/terminal/steps/gates/fields 全部取自命名定义。
      use: "task_standard",
      // 任务子类型：可定义自己的 states/steps/fields；未声明 states 时继承 task。
      subtypes: {
        code_review: {
          label: "代码评审",
          label_en: "Code Review",
          states: ["TODO", "IN_PROGRESS", "DONE", "CANCELLED"],
          initial: "TODO",
          terminal: ["DONE", "CANCELLED"],
          fields: {
            reviewer: false,
            review_content: false,
            custom: [
              /*
              // example of custom fields
              {
                key: "review_scope",
                label: "评审范围",
                label_en: "Review scope",
                type: "text",
              },
              {
                key: "risk_score",
                label: "风险分",
